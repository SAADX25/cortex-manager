{
  "name": "cortex-manager-pro",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic Windows Discord control panel, live server editor and reviewed safe redesign",
  "scripts": {
    "test": "node --test",
    "snapshot": "node src/cli.mjs snapshot",
    "preview": "node src/cli.mjs preview",
    "rebuild": "node src/cli.mjs rebuild",
    "desktop": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File desktop/Launch.ps1",
    "desktop:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Launch.ps1 -BuildOnly",
    "desktop:demo": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Launch.ps1 -Demo",
    "desktop:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Test.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
